# Save as ~/.config/dawar-todo-bots/environment (chmod 600).
BOTS_RELAY_URL=wss://YOUR-DEPLOYED-RELAY.workers.dev/connect
BOTS_MACHINE_ID=dawar-vm
BOTS_MACHINE_SECRET=REPLACE_WITH_32_RANDOM_BYTES
BOTS_NOTIFICATION_SECRET=REPLACE_WITH_32_RANDOM_BYTES
BOTS_SITE_URL=https://work.dawar.ca
BOTS_TIME_ZONE=America/Toronto
# Optional defaults:
# BOTS_ROOT=/home/dawar/bots
# BOTS_STATE_DIR=/home/dawar/.local/share/dawar-todo-bots
# BOTS_HEALTH_PORT=47821
# BOTS_CODEX_BINARY=/home/dawar/.codex/packages/standalone/releases/0.156.1-x86_64-unknown-linux-musl/bin/codex
