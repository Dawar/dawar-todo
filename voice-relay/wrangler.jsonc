{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dawar-todo-voice-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_BASE_URL": "https://work.dawar.ca"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
