{
  "openapi": "3.1.0",
  "info": {
    "title": "Dawar Todo API",
    "version": "1.4.0",
    "description": "Programmatic access to the same tasks, projects, recurrence, snooze, completion, conflict-free field synchronization, merge, undo, settings, calendar-sharing, and attachment operations used by the Dawar Todo UI. A newly created priority-1 task automatically starts the owner's urgent call-and-text escalation. Create a personal token in Settings, then send it as `Authorization: Bearer dt_live_...`. Tokens have full read/write access and should be treated as passwords. Token creation, revocation, profile-phone management, and alert acknowledgement intentionally require an interactive ChatGPT session and are not exposed here."
  },
  "servers": [
    {
      "url": "/",
      "description": "The same origin that served this specification"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Todos" },
    { "name": "Projects" },
    { "name": "Attachments" },
    { "name": "Settings" },
    { "name": "Calendar sharing" }
  ],
  "paths": {
    "/api/todos": {
      "get": {
        "tags": ["Todos"],
        "operationId": "listTodos",
        "summary": "List every non-deleted task",
        "description": "Returns open, snoozed, and completed tasks in their persistent canonical order.",
        "responses": {
          "200": {
            "description": "All tasks",
            "content": { "application/json": { "schema": { "type": "object", "required": ["todos"], "properties": { "todos": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Todos"],
        "operationId": "createTodo",
        "summary": "Create an open task",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTodo" } } }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": { "application/json": { "schema": { "type": "object", "required": ["todo"], "properties": { "todo": { "$ref": "#/components/schemas/Todo" }, "urgentAlert": { "$ref": "#/components/schemas/UrgentAlert" } } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/todos/{id}": {
      "patch": {
        "tags": ["Todos"],
        "operationId": "updateTodo",
        "summary": "Update task details or state",
        "parameters": [{ "$ref": "#/components/parameters/TodoId" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateTodo" } } }
        },
        "responses": {
          "200": {
            "description": "Updated task and Undo token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TodoMutation" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/todos/bulk": {
      "post": {
        "tags": ["Todos"],
        "operationId": "bulkUpdateTodos",
        "summary": "Complete, snooze, wake, reassign, merge, or delete tasks",
        "description": "Use `reproject` with `project: null` to remove assignment. Use `unsnooze` to wake a snoozed task, or `reopen` to reopen completed tasks. `snooze` uses the configured next-day wake time and rejects tasks with a recurring schedule. `adjust_snooze` requires either `snoozePreset` or a `snoozedLocal` date and time interpreted in the user's configured timezone. Merge deletes the sources after creating the merged task. Mutation responses include an Undo token except for `adjust_snooze`, which deliberately preserves the preceding snooze Undo token.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkTodoRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Bulk result",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BulkTodoResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/todos/reorder": {
      "patch": {
        "tags": ["Todos"],
        "operationId": "reorderTodos",
        "summary": "Persist the canonical task order",
        "description": "Send the task IDs in the desired order. Tasks created by another client and absent from this snapshot retain their relative slots.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["orderedIds", "operationId"], "properties": { "orderedIds": { "type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }, "operationId": { "type": "string", "format": "uuid" } } } } }
        },
        "responses": {
          "200": {
            "description": "Current tasks in canonical order",
            "content": { "application/json": { "schema": { "type": "object", "required": ["todos", "changedIds"], "properties": { "todos": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } }, "changedIds": { "type": "array", "items": { "type": "integer" } } } } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/todos/undo": {
      "post": {
        "tags": ["Todos"],
        "operationId": "undoTodoAction",
        "summary": "Undo a mutation",
        "description": "Undo tokens are single-use and retained for up to seven days.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["undoToken"], "properties": { "undoToken": { "type": "string", "format": "uuid" } } } } }
        },
        "responses": {
          "200": {
            "description": "Current restored state",
            "content": { "application/json": { "schema": { "type": "object", "required": ["todos", "restored"], "properties": { "todos": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } }, "restored": { "type": "integer" }, "restoredAttachments": { "type": "integer" } } } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["Projects"],
        "operationId": "listProjects",
        "summary": "List registered project names",
        "responses": {
          "200": { "description": "Project names", "content": { "application/json": { "schema": { "type": "object", "required": ["projects"], "properties": { "projects": { "type": "array", "items": { "type": "string" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Projects"],
        "operationId": "createProject",
        "summary": "Create a project",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 120 } } } } } },
        "responses": {
          "201": { "description": "Project created", "content": { "application/json": { "schema": { "type": "object", "required": ["project"], "properties": { "project": { "type": "string" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "delete": {
        "tags": ["Projects"],
        "operationId": "deleteProject",
        "summary": "Delete a project and reassign or delete its tasks",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name", "mode"], "properties": { "name": { "type": "string" }, "mode": { "type": "string", "enum": ["reassign", "delete"] }, "targetProject": { "type": ["string", "null"], "description": "Required when mode is reassign." } } } } } },
        "responses": {
          "200": { "description": "Project deletion result", "content": { "application/json": { "schema": { "type": "object", "properties": { "project": { "type": "string" }, "mode": { "type": "string" }, "affected": { "type": "integer" }, "targetProject": { "type": ["string", "null"] }, "undoToken": { "type": ["string", "null"] } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/settings": {
      "get": {
        "tags": ["Settings"],
        "operationId": "getSettings",
        "summary": "Read user preferences",
        "responses": {
          "200": { "description": "Settings", "content": { "application/json": { "schema": { "type": "object", "required": ["settings"], "properties": { "settings": { "$ref": "#/components/schemas/Settings" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Settings"],
        "operationId": "updateSettings",
        "summary": "Update user preferences",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Settings" } } } },
        "responses": {
          "200": { "description": "Updated settings", "content": { "application/json": { "schema": { "type": "object", "required": ["settings"], "properties": { "settings": { "$ref": "#/components/schemas/Settings" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/calendar-feeds": {
      "get": {
        "tags": ["Calendar sharing"],
        "operationId": "listCalendarFeeds",
        "summary": "List active public calendar feeds",
        "responses": {
          "200": { "description": "Calendar feeds", "content": { "application/json": { "schema": { "type": "object", "required": ["feeds"], "properties": { "feeds": { "type": "array", "items": { "$ref": "#/components/schemas/CalendarFeed" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Calendar sharing"],
        "operationId": "createCalendarFeed",
        "summary": "Create a tokenized public iCal feed",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 80 } } } } } },
        "responses": {
          "201": { "description": "Calendar feed created", "content": { "application/json": { "schema": { "type": "object", "required": ["feed"], "properties": { "feed": { "$ref": "#/components/schemas/CalendarFeed" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/calendar-feeds/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/UuidId" }],
      "patch": {
        "tags": ["Calendar sharing"],
        "operationId": "regenerateCalendarFeed",
        "summary": "Regenerate a feed token and invalidate its old URL",
        "responses": {
          "200": { "description": "Regenerated feed", "content": { "application/json": { "schema": { "type": "object", "required": ["feed"], "properties": { "feed": { "$ref": "#/components/schemas/CalendarFeed" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Calendar sharing"],
        "operationId": "revokeCalendarFeed",
        "summary": "Revoke a public calendar feed",
        "responses": {
          "200": { "description": "Feed revoked", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string", "format": "uuid" }, "revoked": { "const": true } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/todos/{id}/attachments": {
      "parameters": [{ "$ref": "#/components/parameters/TodoId" }],
      "get": {
        "tags": ["Attachments"],
        "operationId": "listTodoAttachments",
        "summary": "List a task's attachments with temporary signed URLs",
        "description": "Each result includes a one-hour originalUrl that downloads the original bytes without forwarding the Dawar Todo Bearer token. Images also include thumbnailUrl and displayUrl; audio and video include inline playback URLs.",
        "responses": {
          "200": { "description": "Attachments", "content": { "application/json": { "schema": { "type": "object", "required": ["attachments"], "properties": { "attachments": { "type": "array", "items": { "$ref": "#/components/schemas/Attachment" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Attachments"],
        "operationId": "uploadTodoAttachment",
        "summary": "Upload one attachment directly or prepare a browser upload",
        "description": "API agents should send multipart/form-data with one file for a single-request private upload. The server inspects and optimizes images, stores voice memos and files, and returns ready attachment metadata. kind is inferred from content type when omitted; supply durationMs for audio or video. The application/json form preserves the lower-level presigned prepare/upload/finalize workflow used by the web app.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": { "schema": { "$ref": "#/components/schemas/DirectAttachmentUpload" } },
            "application/json": { "schema": { "$ref": "#/components/schemas/PrepareAttachment" } }
          }
        },
        "responses": {
          "201": { "description": "Ready attachment for multipart requests, or presigned targets for JSON requests", "content": { "application/json": { "schema": { "oneOf": [{ "$ref": "#/components/schemas/AttachmentResponse" }, { "$ref": "#/components/schemas/PreparedUpload" }] } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Attachments"],
        "operationId": "finalizeTodoAttachmentUpload",
        "summary": "Finalize a completed task attachment upload",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/FinalizeAttachment" } } } },
        "responses": {
          "200": { "description": "Finalized attachment", "content": { "application/json": { "schema": { "type": "object", "required": ["attachment"], "properties": { "attachment": { "$ref": "#/components/schemas/Attachment" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/todos/{id}/attachments/{attachmentId}": {
      "delete": {
        "tags": ["Attachments"],
        "operationId": "deleteTodoAttachment",
        "summary": "Delete an attachment with Undo support",
        "parameters": [{ "$ref": "#/components/parameters/TodoId" }, { "$ref": "#/components/parameters/AttachmentId" }],
        "responses": {
          "200": { "description": "Attachment deleted", "content": { "application/json": { "schema": { "type": "object", "properties": { "attachmentId": { "type": "string", "format": "uuid" }, "undoToken": { "type": "string", "format": "uuid" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/attachments/drafts": {
      "post": {
        "tags": ["Attachments"],
        "operationId": "prepareDraftAttachmentUpload",
        "summary": "Prepare an attachment before creating its task",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/PrepareAttachment" }, { "type": "object", "required": ["draftToken"], "properties": { "draftToken": { "type": "string", "format": "uuid" } } }] } } } },
        "responses": {
          "201": { "description": "Presigned upload targets", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PreparedUpload" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Attachments"],
        "operationId": "finalizeDraftAttachmentUpload",
        "summary": "Finalize a draft upload before task creation",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/FinalizeAttachment" }, { "type": "object", "required": ["draftToken"], "properties": { "draftToken": { "type": "string", "format": "uuid" } } }] } } } },
        "responses": {
          "200": { "description": "Finalized draft attachment", "content": { "application/json": { "schema": { "type": "object", "required": ["attachment"], "properties": { "attachment": { "$ref": "#/components/schemas/Attachment" } } } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/attachments/drafts/{attachmentId}": {
      "delete": {
        "tags": ["Attachments"],
        "operationId": "deleteDraftAttachment",
        "summary": "Delete an unclaimed draft attachment",
        "parameters": [{ "$ref": "#/components/parameters/AttachmentId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["draftToken"], "properties": { "draftToken": { "type": "string", "format": "uuid" } } } } } },
        "responses": {
          "200": { "description": "Draft attachment deleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Dawar Todo personal API token",
        "description": "Send the token generated in Settings. Example: `Authorization: Bearer dt_live_...`"
      }
    },
    "parameters": {
      "TodoId": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } },
      "UuidId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "AttachmentId": { "name": "attachmentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Missing, invalid, expired, or revoked token", "headers": { "WWW-Authenticate": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Resource not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "The operation conflicts with current state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "UrgentAlert": {
        "type": "object",
        "readOnly": true,
        "required": ["id", "state", "channels", "attemptNumber", "nextAttemptAt"],
        "description": "Present when this API-token request created a priority-1 task. Calls and texts continue until the owner acknowledges or durably acts on the task.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "state": { "type": "string", "enum": ["pending", "awaiting_ack", "blocked_configuration", "acknowledged", "cancelled"] },
          "channels": { "type": "array", "items": { "type": "string", "enum": ["sms", "voice"] } },
          "attemptNumber": { "type": "integer", "minimum": 1 },
          "nextAttemptAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "Todo": {
        "type": "object",
        "required": ["id", "title", "notes", "status", "priority", "pinned", "sortOrder", "createdAt", "updatedAt", "attachmentCount"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string", "maxLength": 2000 },
          "notes": { "type": "string", "maxLength": 500000, "description": "Markdown task description." },
          "status": { "type": "string", "enum": ["open", "completed"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 4, "description": "1 urgent, 2 high, 3 normal, 4 low" },
          "dueDate": { "type": ["string", "null"], "format": "date" },
          "project": { "type": ["string", "null"] },
          "context": { "type": ["string", "null"] },
          "sourceKind": { "type": ["string", "null"] },
          "sourceId": { "type": ["integer", "null"] },
          "clientId": { "type": ["string", "null"] },
          "completedAt": { "type": ["string", "null"], "format": "date-time" },
          "snoozedUntil": { "type": ["string", "null"], "format": "date-time", "description": "Future wake timestamp for a snoozed open task. Normal list and sync reads clear an expired timestamp and return the task to Open." },
          "recurrenceCron": { "type": ["string", "null"], "description": "Five-field cron expression evaluated in the configured snoozeTimeZone. Recurring tasks cannot be snoozed." },
          "recurrenceLastFiredAt": { "type": ["string", "null"], "format": "date-time", "readOnly": true, "description": "Last scheduled minute processed for this task." },
          "pinned": { "type": "boolean", "description": "Hoists the task into the Pinned group in the Open view. The value persists but is not rendered in other views." },
          "sortOrder": { "type": "integer", "readOnly": true, "description": "Persistent canonical list position. Use the reorder endpoint to change it." },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "attachmentCount": { "type": "integer", "minimum": 0 }
        }
      },
      "CreateTodo": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "notes": { "type": "string", "maxLength": 500000, "description": "Markdown task description." },
          "status": { "const": "open" },
          "priority": { "type": "integer", "minimum": 1, "maximum": 4, "default": 3, "description": "1 urgent, 2 high, 3 normal, 4 low. Creating a priority-1 task with this Bearer token immediately starts the owner's urgent call-and-text escalation." },
          "dueDate": { "type": ["string", "null"], "format": "date" },
          "project": { "type": ["string", "null"], "maxLength": 120 },
          "context": { "type": ["string", "null"] },
          "recurrenceCron": { "type": ["string", "null"], "description": "Optional five-field cron expression evaluated in the configured snoozeTimeZone." },
          "clientId": { "type": "string", "format": "uuid", "description": "Optional idempotency key for offline or retried creation." },
          "draftToken": { "type": "string", "format": "uuid" },
          "attachmentIds": { "type": "array", "maxItems": 12, "items": { "type": "string", "format": "uuid" } }
        }
      },
      "UpdateTodo": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "notes": { "type": "string", "maxLength": 500000, "description": "Markdown task description." },
          "status": { "type": "string", "enum": ["open", "completed"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 4 },
          "dueDate": { "type": ["string", "null"], "format": "date" },
          "project": { "type": ["string", "null"], "maxLength": 120 },
          "context": { "type": ["string", "null"] },
          "recurrenceCron": { "type": ["string", "null"], "description": "Set a five-field cron schedule or null to stop recurrence. Assigning a schedule clears any snooze." },
          "pinned": { "type": "boolean", "description": "Pin or unpin the task in the Open view without changing task state." },
          "autosave": { "type": "boolean", "description": "When true, suppresses the per-edit Undo snapshot used by interactive autosave." },
          "mutation": { "$ref": "#/components/schemas/SyncMutation" }
        }
      },
      "SyncMutation": {
        "type": "object",
        "required": ["mutationId", "fieldTimestamps"],
        "description": "Optional idempotent field-level last-writer-wins metadata for offline or concurrent editing. Independent fields merge; same-field conflicts resolve deterministically by timestamp and mutation ID.",
        "properties": {
          "mutationId": { "type": "string", "format": "uuid" },
          "fieldTimestamps": {
            "type": "object",
            "additionalProperties": { "type": "string", "format": "date-time" },
            "description": "Timestamp for each field present in this update. Client clocks more than five minutes ahead are rejected."
          }
        }
      },
      "TodoMutation": {
        "type": "object",
        "required": ["todo", "undoToken"],
        "properties": { "todo": { "$ref": "#/components/schemas/Todo" }, "undoToken": { "type": ["string", "null"], "format": "uuid" }, "appliedFields": { "type": "array", "items": { "type": "string" }, "description": "Fields accepted after conflict resolution." } }
      },
      "BulkTodoRequest": {
        "type": "object",
        "required": ["ids", "action"],
        "properties": {
          "ids": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
          "action": { "type": "string", "enum": ["complete", "reopen", "snooze", "unsnooze", "reproject", "delete", "merge", "adjust_snooze"] },
          "project": { "type": ["string", "null"], "maxLength": 120 },
          "snoozePreset": { "type": "string", "enum": ["15m", "30m", "45m", "1h", "90m", "2h", "3h", "4h", "6h", "8h", "12h", "8pm"], "description": "Relative snooze adjustment from 15 minutes through 12 hours. `8pm` is retained for backward compatibility; current clients use `snoozedLocal` for exact times." },
          "snoozedLocal": { "type": "string", "example": "2026-07-23T14:30", "description": "Future local date and time in YYYY-MM-DDTHH:mm form, interpreted in the user's configured timezone. Use instead of snoozePreset for a custom wake time." }
        }
      },
      "BulkTodoResponse": {
        "type": "object",
        "properties": {
          "ids": { "type": "array", "items": { "type": "integer" } },
          "todos": { "type": "array", "items": { "$ref": "#/components/schemas/Todo" } },
          "todo": { "$ref": "#/components/schemas/Todo" },
          "snoozedUntil": { "type": ["string", "null"], "format": "date-time" },
          "undoToken": { "type": "string", "format": "uuid" }
        }
      },
      "Settings": {
        "type": "object",
        "required": ["snoozeTimeZone", "snoozeWakeHour", "snoozeQuickPresets", "realtimeVoice"],
        "properties": { "snoozeTimeZone": { "type": "string", "example": "America/Toronto", "description": "IANA timezone used for both snooze wake times and recurring cron schedules." }, "snoozeWakeHour": { "type": "integer", "minimum": 0, "maximum": 23 }, "snoozeQuickPresets": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "enum": ["15m", "30m", "45m", "1h", "90m", "2h", "3h", "4h", "6h", "8h", "12h"] }, "description": "Four distinct Quick Snooze buttons. The server normalizes them shortest-to-longest." }, "realtimeVoice": { "type": "string", "enum": ["marin", "cedar", "alloy", "ash", "ballad", "coral", "echo", "sage", "shimmer", "verse"], "description": "Voice used when starting new browser or phone Talk sessions." } }
      },
      "CalendarFeed": {
        "type": "object",
        "required": ["id", "name", "url", "createdAt", "updatedAt"],
        "properties": { "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } }
      },
      "Attachment": {
        "type": "object",
        "required": ["id", "fileName", "mimeType", "byteSize", "kind", "sortOrder", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "todoId": { "type": ["integer", "null"] },
          "fileName": { "type": "string" },
          "mimeType": { "type": "string" },
          "byteSize": { "type": "integer" },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "kind": { "type": "string", "enum": ["image", "audio", "video", "file"] },
          "durationMs": { "type": "integer" },
          "sortOrder": { "type": "integer" },
          "thumbnailUrl": { "type": "string", "description": "One-hour image thumbnail URL, or an empty string when not applicable." },
          "displayUrl": { "type": "string", "description": "One-hour optimized image URL, or an empty string when not applicable." },
          "originalUrl": { "type": "string", "format": "uri", "description": "One-hour download URL for the original bytes. Do not forward the API Authorization header to this storage URL." },
          "audioUrl": { "type": "string", "description": "One-hour inline audio URL, or an empty string when not applicable." },
          "videoUrl": { "type": "string", "description": "One-hour inline video URL, or an empty string when not applicable." },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AttachmentResponse": {
        "type": "object",
        "required": ["attachment"],
        "properties": { "attachment": { "$ref": "#/components/schemas/Attachment" } }
      },
      "DirectAttachmentUpload": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string", "format": "binary", "description": "One image, voice memo, video, document, or archive." },
          "kind": { "type": "string", "enum": ["image", "audio", "video", "file"], "description": "Optional override; normally inferred from MIME type." },
          "mimeType": { "type": "string", "description": "Optional MIME override for clients that upload application/octet-stream." },
          "durationMs": { "type": "integer", "minimum": 1, "description": "Required for audio and video; ignored for images and generic files." }
        }
      },
      "PrepareAttachment": {
        "type": "object",
        "required": ["fileName", "mimeType", "byteSize"],
        "properties": {
          "fileName": { "type": "string" },
          "mimeType": { "type": "string" },
          "byteSize": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string", "enum": ["image", "audio", "video", "file"], "default": "image" },
          "displayMimeType": { "type": "string", "description": "Required for an optimized image display rendition." },
          "thumbnailMimeType": { "type": "string", "description": "Required for an optimized image thumbnail rendition." }
        }
      },
      "FinalizeAttachment": {
        "type": "object",
        "required": ["uploadId"],
        "properties": {
          "uploadId": { "type": "string", "format": "uuid" },
          "kind": { "type": "string", "enum": ["image", "audio", "video", "file"], "default": "image" },
          "width": { "type": "integer", "minimum": 1, "description": "Required for images." },
          "height": { "type": "integer", "minimum": 1, "description": "Required for images." },
          "durationMs": { "type": "integer", "minimum": 0, "description": "Required for audio and video." }
        }
      },
      "PrivatePostTarget": {
        "type": "object",
        "required": ["url", "fields"],
        "properties": { "url": { "type": "string", "format": "uri" }, "fields": { "type": "object", "additionalProperties": { "type": "string" } } }
      },
      "PreparedUpload": {
        "type": "object",
        "required": ["uploadId", "uploads"],
        "properties": {
          "uploadId": { "type": "string", "format": "uuid" },
          "uploads": {
            "type": "object",
            "properties": {
              "original": { "$ref": "#/components/schemas/PrivatePostTarget" },
              "display": { "$ref": "#/components/schemas/PrivatePostTarget" },
              "thumbnail": { "$ref": "#/components/schemas/PrivatePostTarget" }
            }
          }
        }
      }
    }
  }
}
